{
  "description": "bookwright LaTeX-macro-leak prevention",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_latex_macro_leak.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
